rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}


service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles
      allow read: if true;

      // Only the user can create/update their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Users cannot delete their profiles
      allow delete: if false;

      // Wishlist subcollection (index for fast lookup)
      match /wishlist/{postId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }
    }

    // Posts collection (sneaker posts)
    match /posts/{postId} {
      // Anyone can read posts (including queries)
      allow read: if true;

      // Authenticated users can create posts
      allow create: if isAuthenticated();

      // Only post creator can update their posts (full edit)
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;

      // Allow signed-in users to only change wishers + updatedAt (wishlist toggle)
      allow update: if isAuthenticated() &&
                    request.resource.data.diff(resource.data).changedKeys()
                      .hasOnly(['wishers', 'updatedAt']);

      // Only post creator can delete their posts
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }

    // Listings collection (individual sneaker listings)
    match /listings/{listingId} {
      // Anyone can read listings
      allow read: if true;

      // Authenticated users can create listings
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid;

      // Only listing creator can update their listings
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;

      // Only listing creator can delete their listings
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }

    // Legacy tradeRequests collection
    match /tradeRequests/{tradeId} {
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.posterId is string
        && request.resource.data.posterId != request.auth.uid;

      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid
          || resource.data.posterId == request.auth.uid);

      allow update: if request.auth != null
        && (resource.data.senderId == request.auth.uid
          || resource.data.posterId == request.auth.uid)
        // prevent swapping participants
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.posterId == resource.data.posterId;

      allow delete: if false;
    }


    // Trades collection (new schema with fromUserId/toUserId)
    match /trades/{tradeId} {
      // Participants can read their trades
      allow read: if isAuthenticated() &&
                  (resource.data.fromUserId == request.auth.uid ||
                   resource.data.toUserId == request.auth.uid);

      // Sender can create trades
      allow create: if isAuthenticated() &&
                    request.resource.data.fromUserId == request.auth.uid &&
                    request.resource.data.toUserId is string &&
                    request.resource.data.toUserId != request.auth.uid;

      // Participants can update (for decline, read status, etc.)
      allow update: if isAuthenticated() &&
                    (resource.data.fromUserId == request.auth.uid ||
                     resource.data.toUserId == request.auth.uid) &&
                    // prevent swapping participants
                    request.resource.data.fromUserId == resource.data.fromUserId &&
                    request.resource.data.toUserId == resource.data.toUserId;

      // Nobody can delete trades (for record keeping)
      allow delete: if false;
    }

    // Orders collection
    match /orders/{orderId} {
      // Only participants can read an order
      allow read: if isAuthenticated() &&
                  (resource.data.sender.id == request.auth.uid ||
                   resource.data.poster.id == request.auth.uid);

      // Authenticated users can create orders
      allow create: if isAuthenticated();

      // Only participants can update an order
      allow update: if isAuthenticated() &&
                    (resource.data.sender.id == request.auth.uid ||
                     resource.data.poster.id == request.auth.uid);

      // Nobody can delete orders (for record keeping)
      allow delete: if false;
    }

    // Image Jobs collection (for background image processing)
    match /image_jobs/{jobId} {
      // Authenticated users can create image jobs
      allow create: if isAuthenticated();

      // For now, allow signed-in users to read/update/delete (you can tighten later)
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /users/{userId}/private/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }


    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
