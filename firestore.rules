rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}


service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles
      allow read: if true;

      // Only the user can create/update their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Users cannot delete their profiles
      allow delete: if false;

      // Wishlist subcollection (index for fast lookup)
      match /wishlist/{postId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }

      // Notifications subcollection — written by Cloud Functions, read/mark-read by owner
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        // Only allow updating the `read` field
        allow update: if isOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // Posts collection (sneaker posts)
    match /posts/{postId} {
      // Anyone can read posts (including queries)
      allow read: if true;

      // Authenticated users can create posts
      allow create: if isAuthenticated();

      // Only post creator can update their posts (full edit)
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;

      // Allow signed-in users to only change wishers + updatedAt (wishlist toggle)
      allow update: if isAuthenticated() &&
                    request.resource.data.diff(resource.data).changedKeys()
                      .hasOnly(['wishers', 'updatedAt']);

      // Only post creator can delete their posts
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }

    // Listings collection (individual sneaker listings)
    match /listings/{listingId} {
      // Anyone can read listings
      allow read: if true;

      // Authenticated users can create listings
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid;

      // Only listing creator can update their listings
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;

      // Only listing creator can delete their listings
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }

    // Legacy tradeRequests collection
    match /tradeRequests/{tradeId} {
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.posterId is string
        && request.resource.data.posterId != request.auth.uid;

      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid
          || resource.data.posterId == request.auth.uid);

      allow update: if request.auth != null
        && (resource.data.senderId == request.auth.uid
          || resource.data.posterId == request.auth.uid)
        // prevent swapping participants
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.posterId == resource.data.posterId;

      allow delete: if false;
    }


    // Trades collection (new schema with fromUserId/toUserId)
    match /trades/{tradeId} {
      // Participants can read their trades
      allow read: if isAuthenticated() &&
                  (resource.data.fromUserId == request.auth.uid ||
                   resource.data.toUserId == request.auth.uid);

      // Sender can create trades
      allow create: if isAuthenticated() &&
                    request.resource.data.fromUserId == request.auth.uid &&
                    request.resource.data.toUserId is string &&
                    request.resource.data.toUserId != request.auth.uid;

      // Participants can update (for decline, read status, etc.)
      allow update: if isAuthenticated() &&
                    (resource.data.fromUserId == request.auth.uid ||
                     resource.data.toUserId == request.auth.uid) &&
                    // prevent swapping participants
                    request.resource.data.fromUserId == resource.data.fromUserId &&
                    request.resource.data.toUserId == resource.data.toUserId;

      // Nobody can delete trades (for record keeping)
      allow delete: if false;
    }

    // Orders collection — all writes go through Cloud Functions (admin SDK bypasses rules).
    // Direct client writes are intentionally blocked.
    match /orders/{orderId} {
      // Only trade participants can read their order (uses the `users` array for O(1) lookup)
      allow read: if isAuthenticated() &&
                  request.auth.uid in resource.data.users;

      // No direct client writes allowed — Cloud Functions handle all mutations
      allow create, update, delete: if false;
    }

    // App configuration — readable by authenticated users, writable only via admin SDK
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Image Jobs collection (for background image processing)
    match /image_jobs/{jobId} {
      // Authenticated users can create image jobs
      allow create: if isAuthenticated();

      // For now, allow signed-in users to read/update/delete (you can tighten later)
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /users/{userId}/private/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }


    // Conversations (DM threads)
    match /conversations/{conversationId} {
      // Participants can read existing conversations.
      // resource == null covers getDoc on a non-existent doc (needed before first message).
      allow read: if isAuthenticated() &&
                  (resource == null || request.auth.uid in resource.data.participants);

      // Either participant can create (sendMessage creates the doc on first message)
      allow create: if isAuthenticated() &&
                    request.auth.uid in request.resource.data.participants &&
                    request.resource.data.participants.size() == 2;

      // Participants can update lastMessage, unreadCount, participantInfo — but not swap participants
      allow update: if isAuthenticated() &&
                    request.auth.uid in resource.data.participants &&
                    request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Only participants can read messages
        allow read: if isAuthenticated() &&
                    request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Participants can create messages; senderId must match the writer
        allow create: if isAuthenticated() &&
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                      request.resource.data.senderId == request.auth.uid;

        // Messages are immutable
        allow update, delete: if false;
      }
    }

    // Flagged attempt log — authenticated users can write their own attempts; no client reads
    match /flaggedAttempts/{attemptId} {
      allow create: if isAuthenticated() &&
                    request.resource.data.senderId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
